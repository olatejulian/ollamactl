<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Socket-level integration tests for ollamactl infrastructure.</Description>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ollamactl.Cli/Ollamactl.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Ollamactl.Application/Ollamactl.Application.csproj" />
    <ProjectReference Include="../../src/Ollamactl.Domain/Ollamactl.Domain.csproj" />
    <ProjectReference Include="../../src/Ollamactl.Infrastructure/Ollamactl.Infrastructure.csproj" />
    <ProjectReference Include="../Ollamactl.TestKit/Ollamactl.TestKit.csproj" />
  </ItemGroup>
</Project>
